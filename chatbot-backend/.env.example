# Example Environment Configuration

# GROQ LLM Configuration (FREE API key!)
# Setup:
# 1. Sign up at https://console.groq.com
# 2. Create an API key
# 3. Set it below or as an environment variable
#
# Models available:
# - llama-3.3-70b-versatile (recommended - powerful & fast)
# - llama-3.1-8b-instant (fastest)
# - mixtral-8x7b-32768 (good balance)
GROQ_API_KEY=gsk_your_api_key_here

# NOTE: No local LLM server needed! Groq runs in the cloud.

# Local Development
SERVER_PORT=8080
ENVIRONMENT=development

# Database (post-MVP)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=saarthi_chatbot
# DB_USER=chatbot_user
# DB_PASSWORD=secure_password_here

# Logging
LOG_LEVEL=DEBUG

# Sessions
SESSION_TIMEOUT_MINUTES=30
MAX_CONVERSATION_HISTORY=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000,http://localhost:5173

# Admin/Monitoring
ADMIN_EMAIL=admin@example.com
ENABLE_CRISIS_LOGGING=true
CRISIS_ALERT_EMAIL=crisis-team@example.com
